<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="1" author="alfred">
        <preConditions onFail="MARK_RAN">
            <not>
                <tableExists tableName="block"/>
            </not>
        </preConditions>
        <createTable tableName="block">
            <column name="id" type="bigint" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="name" type="varchar(255)">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <createTable tableName="apartment_type">
            <column name="id" type="bigint" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="name" type="varchar(255)">
                <constraints nullable="false"/>
            </column>
            <column name="base_occupancy" type="int">
                <constraints nullable="false"/>
            </column>
            <column name="litres_per_person" type="double">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <createTable tableName="apartment">
            <column name="id" type="bigint" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="number" type="varchar(255)">
                <constraints nullable="false"/>
            </column>
            <column name="block_id" type="bigint"/>
            <column name="type_id" type="bigint"/>
        </createTable>

        <addForeignKeyConstraint 
            baseColumnNames="block_id"
            baseTableName="apartment"
            constraintName="fk_apartment_block"
            referencedColumnNames="id"
            referencedTableName="block"/>

        <addForeignKeyConstraint 
            baseColumnNames="type_id"
            baseTableName="apartment"
            constraintName="fk_apartment_type"
            referencedColumnNames="id"
            referencedTableName="apartment_type"/>

        <rollback>
            <dropTable tableName="apartment"/>
            <dropTable tableName="apartment_type"/>
            <dropTable tableName="block"/>
        </rollback>
    </changeSet>
</databaseChangeLog>
